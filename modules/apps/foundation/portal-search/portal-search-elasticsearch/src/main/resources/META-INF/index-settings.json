{
	"analysis": {
		"analyzer": {
			"keyword_lowercase": {
				"filter": "lowercase",
				"tokenizer": "keyword"
			},
			"liferay_kuromoji": {
				"char_filter": [
					"html_strip",
					"kuromoji_iteration_mark"
				],
				"filter": [
					"cjk_width",
					"kuromoji_baseform",
					"kuromoji_part_of_speech",
					"kuromoji_stemmer",
					"liferay_kuromoji_readingform",
					"lowercase"
				],
				"tokenizer": "liferay_kuromoji_tokenizer",
				"type": "custom"
			}
		},
		"filter": {
			"liferay_kuromoji_readingform": {
				"type": "kuromoji_readingform",
				"use_romaji": "false"
			}
		},
		"tokenizer": {
			"liferay_kuromoji_tokenizer": {
				"mode": "search",
				"type": "kuromoji_tokenizer"
			}
		}
	}
}